+  function riskLevel(score) {
+    if (score >= 67) return 'danger';
+    if (score >= 34) return 'watch';
+    return 'safe';
+  }
+  function riskLabel(level) { return { safe: '안전', watch: '주의', danger: '위험' }[level]; }
+
+  function renderSnapshot(roads, isSample) {
+    const top3 = [...roads].sort((a, b) => b.risk_score - a.risk_score).slice(0, 3);
+    const grid = document.getElementById('snapshotGrid');
+    grid.innerHTML = '';
+    top3.forEach((r) => {
+      const level = riskLevel(r.risk_score);
+      const card = document.createElement('div');
+      card.className = 'snap-card';
+      card.innerHTML = `
+        <div class="snap-name">${r.road_name}</div>
+        <div class="snap-score">${Number(r.risk_score).toFixed(1)}</div>
+        <span class="snap-badge ${level}">${riskLabel(level)}</span>
+      `;
+      grid.appendChild(card);
+    });
+    document.getElementById('snapshotNote').textContent = isSample
+      ? '지금은 서버 미연결로 예시 값을 보여드리고 있어요.'
+      : '';
+  }
+
+  async function loadSnapshot() {
+    try {
+      const res = await fetch(`${API_BASE}/risk/roads`);
+      if (!res.ok) throw new Error('bad response');
+      const data = await res.json();
+      renderSnapshot(data.length ? data : MOCK_ROADS, data.length === 0);
+    } catch (e) {
+      renderSnapshot(MOCK_ROADS, true);
+    }
+  }
+
+  loadSnapshot();
+</script>
+
+</body>
+</html>
